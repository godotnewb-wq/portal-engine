{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@llm": [
        "./src/llm/index.ts"
      ],
      "@engine/*": [
        "./src/engine/*"
      ],
      "@platform/*": [
        "./src/platform/*"
      ],
      "@app/*": [
        "./src/app/*"
      ]
    }
  },
  "include": [
    "src",
    "tools",
    "tests",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "aliases.ts"
  ]
}
